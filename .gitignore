# This .gitignore file should be placed at the root of your Unity project directory

# ================
# Unity generated
# ================
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# =====================================
# Visual Studio / MonoDevelop / Rider
# =====================================
[Ee]xported[Oo]bj/
.vs/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ==================
# OS generated files
# ==================
.DS_Store*
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ============
# Builds output
# ============
[Bb]uild/
[Bb]uilds/

# ================================================
# Autogenerated by Unity, but usually not necessary
# ================================================
sysinfo.txt

# =====================================
# Crashlytics generated file (for Unity)
# =====================================
crashlytics-build.properties

# =====================================
# Ignore all files in any .vs directory
# =====================================
.vs/

# ====================
# Others
# ====================
*.apk
*.unitypackage
# Various settings files
*.pidb.meta
*.pdb.meta
*.mdb.meta
*.apk.meta
*.apk.obb.meta

# ====================================
# JetBrains Rider
# ====================================
.idea/

# ====================================
# User-specific stuff
# ====================================
[Ll]ocal[Cc]ontent/

# ================
# MacOS generated
# ================
*.DS_Store
.AppleDouble
.LSOverride
Icon
# Thumbnails
._*
# Files that might appear on external disk
.Spotlight-V100
.Trashes
# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

Assets/PixelArtTopDown-Basic/Animation/Player/Idle.png.meta
Assets/PixelArtTopDown-Basic/Animation/Player/Walk.png.meta